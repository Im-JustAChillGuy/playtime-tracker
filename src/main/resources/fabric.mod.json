{
  "schemaVersion": 1,
  "id": "playtimetracker",
  "version": "${version}",
  "name": "Playtime Tracker",
  "description": "A Lightweight Mod that tracks your Minecraft Playtime",
  "authors": [
    "JustAChillGuy"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/playtimetracker/icon.png",

  "environment": "client",

  "entrypoints": {
    "client": [
      "com.example.playtimetracker.PlaytimeTrackerClient"
    ]
  },

  "mixins": [
    "modid.client.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
